---
import BaseLayout from '../layouts/BaseLayout.astro';
import DefenseStory from '../components/DefenseStory.tsx';
import { cv } from '../data/cv';
import { withExperienceYears } from '../lib/experience';

const profileText = withExperienceYears(cv.profile);
---

<BaseLayout title="Defense AI Prototype" description="A prototypical tactical brutalism design for defense and deep tech.">
  <main class="w-full bg-charcoal-900">
    <DefenseStory client:load badge={cv.hero_badge} profileText={profileText} />
  </main>
</BaseLayout>
