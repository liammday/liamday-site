---
import BaseLayout from '../layouts/BaseLayout.astro';
import DefenceConsole from '../components/DefenceConsole.tsx';
import { cv } from '../data/cv';
import { appProjects } from '../data/projects';
import { site } from '../data/site';
import { withExperienceYears } from '../lib/experience';
import { geoEmployment, geoEducation, HOME_GEO } from '../data/defence';

const profileText = withExperienceYears(cv.profile);
const stats = cv.hero_stats.map((s) => ({ ...s, value: withExperienceYears(s.value) }));

// Keep the island bundle lean: only the fields the ledger renders/sorts.
const projects = appProjects.map((p) => ({
  name: p.name,
  link: p.link,
  summary: p.summary,
  platform: p.platform,
  technologies: p.technologies,
  tags: p.tags,
  order: p.order,
  date_started: p.date_started,
  date_finished: p.date_finished,
}));
---

<BaseLayout footer={false}>
  <main class="w-full bg-charcoal-900" data-tactical>
    <DefenceConsole
      client:load
      badge={cv.hero_badge}
      profileText={profileText}
      stats={stats}
      roles={geoEmployment}
      competencies={cv.competencies}
      education={geoEducation}
      certifications={cv.certifications}
      projects={projects}
      homeGeo={HOME_GEO}
      contact={{
        email: site.contact.email,
        linkedin: site.social.linkedin,
        github: site.social.github,
      }}
    />
  </main>
</BaseLayout>

<style is:global>
  /* ── Tactical palette — the site's landing experience ─────────────────────
     Overrides the runtime theme channels only beneath [data-tactical]; other
     pages keep the standard theme, and this page pins the same dark palette
     in BOTH site themes (an instrument has no light mode).

     Values from the defence-tech design research (2026-07-16): charcoal canvas
     #16171D (Arondite), raised panels #1E2124 (Palantir), hairlines #26272F,
     text ramp #E9EAF0 / #A3A4AF / #71727D. Never pure black, never pure white
     body text. --accent is the sky-tone spectrum set inline by the island;
     the static value here is the pre-hydration fallback (= skyAccentAt(0)). */
  [data-tactical] {
    --accent: 96 150 255;

    --charcoal-900: 22 23 29; /* #16171D canvas */
    --charcoal-950: 16 17 22; /* #101116 */
    --graphite-600: 30 33 36; /* #1E2124 raised panel */
    --graphite-700: 26 28 33;
    --graphite-800: 24 25 30;
    --aluminum-100: 233 234 240; /* #E9EAF0 primary text */
    --aluminum-200: 200 201 210;
    --aluminum-300: 163 164 175; /* #A3A4AF secondary */
    --aluminum-400: 113 114 125; /* #71727D tertiary / kickers */
    --aluminum-500: 38 39 47; /* #26272F hairlines */

    --ember-200: var(--accent);
    --ember-300: var(--accent);
    --ember-400: var(--accent);
    --ember-500: var(--accent);
    --ember-600: var(--accent);

    --spotlight-glow-center: rgb(var(--accent) / 0.18);
    --spotlight-glow-mid: rgb(var(--accent) / 0.06);
  }

  /* ── Type contract (research verdict: grotesque + mono ONLY on this page) ──
     Every researched brand (Anduril/Palantir/Helsing/Arondite/OxDynamics) runs
     one neutral grotesque + one instrumentation mono; none uses a serif. The
     site serif (Fraunces) is therefore retired from this page: display roles
     re-bind to the body grotesque at medium weight, tight tracking, ≤1.0
     leading. Sentence case at display size — caps live in the mono tier only. */
  [data-tactical] .t-display,
  [data-tactical] h1 {
    font-family: var(--ff-body, ui-sans-serif, system-ui, sans-serif);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 0.98;
    color: rgb(var(--aluminum-100));
  }

  [data-tactical] .t-heading {
    font-family: var(--ff-body, ui-sans-serif, system-ui, sans-serif);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: rgb(var(--aluminum-100));
  }

  /* Mono instrumentation tier: kickers, readouts, designation codes, dates.
     Slashed zero + tabular figures = the telemetry look; never a paragraph. */
  [data-tactical] .t-kicker {
    font-family: var(--ff-mono, ui-monospace, monospace);
    font-size: 0.6875rem; /* 11px */
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(var(--aluminum-400));
    font-feature-settings: 'zero' on;
    font-variant-numeric: tabular-nums slashed-zero;
  }

  [data-tactical] .t-readout {
    font-family: var(--ff-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-feature-settings: 'zero' on;
    font-variant-numeric: tabular-nums slashed-zero;
    line-height: 1.7;
  }

  /* Sharp corners: border-radius is SaaS vocabulary; the instrument has none. */
  [data-tactical] a,
  [data-tactical] button {
    border-radius: 0;
  }

  /* Dossier viewer: injected case-study content (built from the same MDX as
     the standalone pages) squares off and calms down inside the instrument. */
  [data-tactical] .dossier-article img,
  [data-tactical] .dossier-article figure,
  [data-tactical] .dossier-article picture {
    border-radius: 0;
  }
  [data-tactical] .dossier-article .surface-panel {
    border-radius: 0;
  }
  /* UpdateTimeline ships its own standalone-page container (mx-auto max-w-5xl
     px-6) — inside the dossier column that padding indents the "Development
     log" heading against the prose. Flatten it to the column grid. */
  [data-tactical] .dossier-article #updates {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }
  /* Gallery bleed helper is tuned for the standalone page's centred column;
     inside the panel just pad it like the rest of the content. */
  [data-tactical] .dossier-article .page-nav-bleed {
    padding-left: 0;
    padding-right: 0;
  }
</style>
